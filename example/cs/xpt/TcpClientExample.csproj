<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>TcpClientExample</AssemblyName>
    <RootNamespace>TcpClientExample</RootNamespace>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Each C# sample owns its own entry point, so compile only this sample's source. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TcpClientExample.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../lang/cs/Wse/Wse.csproj" />
  </ItemGroup>

</Project>
